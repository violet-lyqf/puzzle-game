.container {
  min-height: 100vh;
  background: #1a1a2e;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 60rpx;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  z-index: 1;
}

.title {
  font-size: 64rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #a8b2d8;
  letter-spacing: 2rpx;
}

.score-card {
  width: 100%;
  background: rgba(255,255,255,0.06);
  border-radius: 32rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  padding: 50rpx 20rpx;
  margin-bottom: 60rpx;
}

.score-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.score-icon {
  font-size: 44rpx;
}

.score-value {
  font-size: 52rpx;
  font-weight: bold;
  color: #f5a623;
}

.score-label {
  font-size: 24rpx;
  color: #a8b2d8;
}

.score-divider {
  width: 2rpx;
  height: 100rpx;
  background: rgba(255,255,255,0.1);
}

.btn-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 60rpx;
}

.btn-start {
  width: 100%;
  height: 104rpx;
  background: #e94560;
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 52rpx;
  border: none;
  letter-spacing: 4rpx;
}

.btn-score {
  width: 100%;
  height: 96rpx;
  background: rgba(255,255,255,0.08);
  color: #f5f5f5;
  font-size: 32rpx;
  border-radius: 48rpx;
  border: 1rpx solid rgba(255,255,255,0.2);
}

.btn-reset {
  width: 100%;
  height: 96rpx;
  background: transparent;
  color: #a8b2d8;
  font-size: 28rpx;
  border-radius: 48rpx;
  border: 1rpx solid rgba(168,178,216,0.3);
}

.tips-card {
  width: 100%;
  background: rgba(255,255,255,0.04);
  border-radius: 24rpx;
  padding: 40rpx;
}

.tips-title {
  font-size: 30rpx;
  color: #f5a623;
  font-weight: bold;
  margin-bottom: 24rpx;
  display: block;
}

.tips-item {
  font-size: 26rpx;
  color: #a8b2d8;
  line-height: 1.6;
  display: block;
  margin-bottom: 16rpx;
}