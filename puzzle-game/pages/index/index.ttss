.container {
  min-height: 100vh;
  background: linear-gradient(160deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 60rpx;
  position: relative;
  overflow: hidden;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.08;
}

.bg-circle-1 {
  width: 600rpx;
  height: 600rpx;
  background: #e94560;
  top: -200rpx;
  right: -200rpx;
}

.bg-circle-2 {
  width: 400rpx;
  height: 400rpx;
  background: #0f3460;
  bottom: -100rpx;
  left: -100rpx;
  border: 4rpx solid #e94560;
  background: transparent;
  opacity: 0.2;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  z-index: 1;
}

.title {
  font-size: 64rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 0 30rpx rgba(233,69,96,0.6);
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #a8b2d8;
  letter-spacing: 2rpx;
}

.score-card {
  width: 100%;
  background: rgba(255,255,255,0.06);
  border: 1rpx solid rgba(255,255,255,0.12);
  border-radius: 32rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  padding: 50rpx 20rpx;
  margin-bottom: 60rpx;
  z-index: 1;
}

.score-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.score-icon {
  font-size: 44rpx;
}

.score-value {
  font-size: 52rpx;
  font-weight: bold;
  color: #f5a623;
}

.score-label {
  font-size: 24rpx;
  color: #a8b2d8;
}

.score-divider {
  width: 2rpx;
  height: 100rpx;
  background: rgba(255,255,255,0.1);
}

.btn-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 60rpx;
  z-index: 1;
}

.btn-start {
  width: 100%;
  height: 104rpx;
  background: linear-gradient(135deg, #e94560 0%, #c23152 100%);
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 52rpx;
  border: none;
  box-shadow: 0 10rpx 40rpx rgba(233,69,96,0.45);
  letter-spacing: 4rpx;
}

.btn-score {
  width: 100%;
  height: 96rpx;
  background: rgba(255,255,255,0.08);
  color: #f5f5f5;
  font-size: 32rpx;
  border-radius: 48rpx;
  border: 1rpx solid rgba(255,255,255,0.2);
}

.btn-reset {
  width: 100%;
  height: 96rpx;
  background: transparent;
  color: #a8b2d8;
  font-size: 28rpx;
  border-radius: 48rpx;
  border: 1rpx solid rgba(168,178,216,0.3);
}

.tips-card {
  width: 100%;
  background: rgba(255,255,255,0.04);
  border: 1rpx solid rgba(255,255,255,0.08);
  border-radius: 24rpx;
  padding: 40rpx;
  z-index: 1;
}

.tips-title {
  font-size: 30rpx;
  color: #f5a623;
  font-weight: bold;
  margin-bottom: 24rpx;
  display: block;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.tips-item {
  font-size: 26rpx;
  color: #a8b2d8;
  line-height: 1.6;
}